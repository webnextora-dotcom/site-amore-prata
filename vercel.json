{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "rewrites": [
    {"source": "/pagbank/teste", "destination": "/api/pagbank?stage=start"},
    {"source": "/api/pagbank/callback", "destination": "/api/pagbank?stage=callback"},
    {"source": "/conectar", "destination": "/api/connect?stage=invite"},
    {"source": "/conectar/callback", "destination": "/api/connect?stage=callback"},
    {"source": "/api/delivery-options", "destination": "/api/store?route=delivery-options"},
    {"source": "/api/order-status", "destination": "/api/store?route=order-status"},
    {"source": "/api/order-payment", "destination": "/api/store?route=order-payment"},
    {"source": "/api/shipping-quote", "destination": "/api/store?route=shipping-quote"},
    {"source": "/api/order-tracking", "destination": "/api/store?route=order-tracking"},
    {"source": "/api/delete-product", "destination": "/api/store?route=delete-product"},
    {"source": "/api/admin-password", "destination": "/api/store?route=admin-password"},
    {
      "source": "/admin",
      "destination": "/loja/admin.html"
    },
    {
      "source": "/pedido",
      "destination": "/loja/pedido.html"
    },
    {
      "destination": "/api/store?route=catalog",
      "source": "/api/catalog"
    },
    {
      "destination": "/api/store?route=checkout",
      "source": "/api/checkout"
    },
    {
      "destination": "/api/store?route=webhook",
      "source": "/api/webhook"
    },
    {
      "destination": "/api/store?route=confirm",
      "source": "/api/confirm"
    },
    {
      "destination": "/api/store?route=login",
      "source": "/api/login"
    },
    {
      "destination": "/api/store?route=logout",
      "source": "/api/logout"
    },
    {
      "destination": "/api/store?route=dashboard",
      "source": "/api/dashboard"
    },
    {
      "destination": "/api/store?route=product",
      "source": "/api/product"
    },
    {
      "destination": "/api/store?route=fulfillment",
      "source": "/api/fulfillment"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/loja/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/loja",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/loja/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
